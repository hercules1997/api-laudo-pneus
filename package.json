{
  "name": "api-laudo-pneus",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "build": "node scripts/buildNetlify.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-concurrency=1",
    "import:catalogo": "node scripts/importCatalogo.js",
    "import:avarias": "node scripts/importAvarias.js",
    "extract:vipal": "node scripts/extractVipal.js",
    "setup:neon": "node --env-file-if-exists=.env scripts/setupNeon.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "aws4fetch": "^1.0.20",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "pdfjs-dist": "^5.4.149",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}

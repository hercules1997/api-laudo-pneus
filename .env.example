PORT=3003
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=
# Os catálogos são JSON. Contas/documentos usam Neon quando ativados.
AUTH_GITHUB_REPO=hercules1997/laudo-mobile-acessos
AUTH_GITHUB_BRANCH=main
AUTH_GITHUB_PATH=users.json
AUTH_GITHUB_TOKEN=
AUTH_JWT_SECRET=
AUTH_REQUIRE_LOGIN=false

# Ativar após configurar Neon e armazenamento privado
DOCUMENTS_API_ENABLED=false
APPROVALS_REQUIRED=false

# Neon: dados e contas
DATABASE_URL=
AUTH_STORAGE=github
# Arquivos privados, credenciais somente no servidor
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=us-east-2
STORAGE_BUCKET=laudos-documentos
